#!/usr/bin/env node
// A stand-in for an app store's staged rollout console. All numbers are simulated
// from scenario.json; nothing here talks to a real store.
const fs = require('fs');
const path = require('path');

const HOME = process.env.ROLLOUT_ROOM_HOME || path.join(process.env.HOME, '.rollout-room');
const STATE_FILE = path.join(HOME, 'store', 'state.json');
const SCENARIO = JSON.parse(fs.readFileSync(path.join(HOME, 'store', 'scenario.json'), 'utf8'));

const now = () => Date.now() / 1000;
const stamp = () => new Date().toTimeString().slice(0, 8);

function load() {
  if (!fs.existsSync(STATE_FILE)) return { releases: {}, log: [] };
  return JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
}

function save(state) {
  fs.writeFileSync(STATE_FILE, JSON.stringify(state, null, 2));
}

function fail(message) {
  console.error(`fake-store: ${message}`);
  process.exit(2);
}

function release(state, version) {
  const found = state.releases[version];
  if (!found) fail(`no release ${version}. Known: ${Object.keys(state.releases).join(', ') || 'none'}`);
  return found;
}

// Installs grow while a release is rolling and freeze when it's halted. A halt doesn't
// remove the version from phones, which is the point of the whole project.
function installs(rel, at = now()) {
  const until = rel.status === 'halted' ? rel.haltedAt : at;
  const grown = rel.installedBefore + Math.max(0, until - rel.rollingSince) * SCENARIO.installs_per_second;
  return Math.round(Math.min(grown, (rel.percent / 100) * SCENARIO.users));
}

// A newer release reaches users at random, so it moves the same share of an older
// release's devices as it has of all users. The bad version lingers for a long time.
function remaining(state, version, at = now()) {
  const rel = state.releases[version];
  const stillHere = Object.values(state.releases)
    .filter((other) => other.startedAt > rel.startedAt)
    .reduce((share, other) => share * (1 - installs(other, at) / SCENARIO.users), 1);
  return Math.round(installs(rel, at) * stillHere);
}

function crashFree(version, rel, at = now()) {
  const bad = SCENARIO.versions[version];
  if (!bad) return SCENARIO.baseline_crash_free;
  const elapsed = at - rel.startedAt - bad.spike_after_seconds;
  const progress = Math.min(1, Math.max(0, elapsed / bad.spike_ramp_seconds));
  const rate = SCENARIO.baseline_crash_free - progress * (SCENARIO.baseline_crash_free - bad.crash_free);
  return Math.round(rate * 100) / 100;
}

function describe(state, version) {
  const rel = state.releases[version];
  return {
    version,
    status: rel.status,
    target_percent: rel.percent,
    devices: remaining(state, version),
    crash_free: crashFree(version, rel),
    commit: rel.commit || null,
  };
}

function record(state, line) {
  state.log.push(`${stamp()} ${line}`);
}

function start(state, version, percent, commit) {
  if (state.releases[version]) fail(`${version} already exists, use resume`);
  state.releases[version] = {
    percent,
    commit,
    status: 'rolling',
    startedAt: now(),
    rollingSince: now(),
    installedBefore: 0,
  };
  record(state, `started ${version} at ${percent}%`);
  save(state);
  console.log(`Started ${version} at ${percent}% of ${SCENARIO.users.toLocaleString('en-US')} users.`);
}

function halt(state, version) {
  const rel = release(state, version);
  if (rel.status === 'halted') fail(`${version} is already halted`);
  rel.status = 'halted';
  rel.haltedAt = now();
  record(state, `halted ${version}`);
  save(state);
  console.log(`Halted ${version}. No new devices will receive it.`);
  console.log(`${remaining(state, version).toLocaleString('en-US')} devices still have it and will keep crashing until they update.`);
}

function resume(state, version, percent) {
  const rel = release(state, version);
  if (rel.status === 'rolling') fail(`${version} is already rolling`);
  rel.installedBefore = installs(rel);
  rel.status = 'rolling';
  rel.rollingSince = now();
  rel.percent = percent ?? rel.percent;
  record(state, `resumed ${version} at ${rel.percent}%`);
  save(state);
  console.log(`Resumed ${version} at ${rel.percent}%.`);
}

function status(state, asJson) {
  const rows = Object.keys(state.releases).map((version) => describe(state, version));
  if (asJson) return console.log(JSON.stringify(rows, null, 2));
  if (rows.length === 0) return console.log('No releases yet.');
  for (const row of rows) {
    console.log(
      `${row.version}  ${row.status.padEnd(7)}  target ${String(row.target_percent).padStart(3)}%  ` +
        `${String(row.devices).padStart(7)} devices  crash-free ${row.crash_free.toFixed(2)}%`,
    );
  }
}

function crashes(state, version) {
  const rel = release(state, version);
  const bad = SCENARIO.versions[version];
  const started = now() - rel.startedAt > (bad?.spike_after_seconds ?? 0);
  if (!bad || !started) return console.log(`No crash groups for ${version}.`);
  const { title, frames, segments } = bad.crash;
  console.log(title);
  for (const frame of frames) console.log(`  at ${frame}`);
  console.log(`Share of crashes by account: ${Object.entries(segments).map(([k, v]) => `${k} ${v}%`).join(', ')}`);
}

async function watch(state, version, threshold, timeoutSeconds) {
  const deadline = now() + timeoutSeconds;
  while (now() < deadline) {
    const current = load();
    const rel = release(current, version);
    const rate = crashFree(version, rel);
    console.log(`${stamp()} ${version} crash-free ${rate.toFixed(2)}% on ${remaining(current, version)} devices`);
    if (rate < threshold) {
      console.log(`ALERT ${version} crash-free ${rate.toFixed(2)}% is below ${threshold}%`);
      return;
    }
    await new Promise((resolve) => setTimeout(resolve, 5000));
  }
  console.log(`No breach in ${timeoutSeconds}s. Run watch again to keep watching.`);
  process.exitCode = 3;
}

function option(args, name) {
  const index = args.indexOf(`--${name}`);
  return index === -1 ? undefined : args[index + 1];
}

function main() {
  const [command, ...args] = process.argv.slice(2);
  const state = load();
  const version = args[0];
  const percent = option(args, 'percent') === undefined ? undefined : Number(option(args, 'percent'));

  switch (command) {
    case 'start':
      if (!version || !percent) fail('usage: fake-store start <version> --percent <n> [--commit <sha>]');
      return start(state, version, percent, option(args, 'commit'));
    case 'halt':
      return halt(state, version);
    case 'resume':
      return resume(state, version, percent);
    case 'status':
      return status(state, args.includes('--json'));
    case 'crashes':
      return crashes(state, version);
    case 'watch':
      release(state, version);
      return watch(state, version, Number(option(args, 'threshold') ?? 99), Number(option(args, 'timeout') ?? 100));
    case 'log':
      return console.log(state.log.join('\n'));
    default:
      fail('commands: start, halt, resume, status, crashes, watch, log');
  }
}

main();
